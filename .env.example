# ─── MARSA AI — environment template ────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env`.
# Every provider below has a free tier; no paid keys are required.

# ─── Frontend (Next.js) ─────────────────────────────────────────────────────
# Base URL of the FastAPI gateway the browser talks to.
#
# READ AT BUILD TIME, NOT RUN TIME. `next build` inlines this into the client
# bundle, so changing it without rebuilding does nothing — the app keeps calling
# the old address and silently degrades to fixture mode.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─── LLM routing (LiteLLM) ──────────────────────────────────────────────────
# Groq powers the complexity classifier and the fast path (free tier).
GROQ_API_KEY=
# Gemini free tier — agentic path composer + optional cloud embeddings.
GEMINI_API_KEY=
# Cerebras free tier — optional third provider for LiteLLM fallback.
CEREBRAS_API_KEY=

# Optional, OFF by default. Local Ollama fallback for offline dev only —
# deliberately not the default path (see master spec: no local GPU load).
ENABLE_OLLAMA_FALLBACK=false
OLLAMA_BASE_URL=http://localhost:11434

# ─── Vector store (Postgres + pgvector on Neon or Supabase free tier) ───────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Embeddings ─────────────────────────────────────────────────────────────
# `local` = all-MiniLM-L6-v2 on CPU. `gemini` = text-embedding-004 via API.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Backend runtime ────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS. Never "*". Both loopback spellings
# are listed because a browser treats them as different origins — allowing only
# one fails invisibly, with the request blocked before the server ever sees it.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60

# ─── Container behaviour (Docker / Render only) ─────────────────────────────
# `auto` builds the fast-path index on boot; `never` skips it. The index lives
# partly on local disk, which does not survive a container restart.
MARSA_BOOTSTRAP_INDEX=auto
# `true` refuses to start when the index falls back to the in-process numpy
# store despite DATABASE_URL being set — i.e. the database was unreachable.
# Recommended in production: the fallback succeeds quietly and would otherwise
# give you a healthy service that never touches pgvector.
MARSA_REQUIRE_PGVECTOR=false
# Where corpora, index, graph and models are written. The default resolves
# correctly from a source checkout only; the image sets it to /app/data.
# DATA_DIR=
