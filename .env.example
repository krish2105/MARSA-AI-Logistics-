# ─── MARSA AI — environment template ────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env`.
# Every provider below has a free tier; no paid keys are required.

# ─── Frontend (Next.js) ─────────────────────────────────────────────────────
# Base URL of the FastAPI gateway the browser talks to.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─── LLM routing (LiteLLM) ──────────────────────────────────────────────────
# Groq powers the complexity classifier and the fast path (free tier).
GROQ_API_KEY=
# Gemini free tier — agentic path composer + optional cloud embeddings.
GEMINI_API_KEY=
# Cerebras free tier — optional third provider for LiteLLM fallback.
CEREBRAS_API_KEY=

# Optional, OFF by default. Local Ollama fallback for offline dev only —
# deliberately not the default path (see master spec: no local GPU load).
ENABLE_OLLAMA_FALLBACK=false
OLLAMA_BASE_URL=http://localhost:11434

# ─── Vector store (Postgres + pgvector on Neon or Supabase free tier) ───────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Embeddings ─────────────────────────────────────────────────────────────
# `local` = all-MiniLM-L6-v2 on CPU. `gemini` = text-embedding-004 via API.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Backend runtime ────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS. Lock this down in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
